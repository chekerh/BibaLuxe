# Vagrantfile for BibaLuxe Project (Mac with Parallels - Recommended for Apple Silicon)
# Copy this to Vagrantfile if you have Parallels Desktop installed

Vagrant.configure("2") do |config|
  # Use Parallels box (works great on ARM Macs)
  config.vm.box = "parallels/ubuntu-22.04"

  # VM Configuration with Parallels
  config.vm.provider "parallels" do |prl|
    prl.name = "bibaluxe-dev"
    prl.memory = 4096   # 4GB RAM
    prl.cpus = 2
  end

  # Port Forwarding: VM ports → your Mac
  config.vm.network "forwarded_port", guest: 9090, host: 9090, auto_correct: true   # Prometheus
  config.vm.network "forwarded_port", guest: 3000, host: 3000, auto_correct: true   # Grafana
  config.vm.network "forwarded_port", guest: 9000, host: 9000, auto_correct: true   # SonarQube
  config.vm.network "forwarded_port", guest: 3001, host: 3001, auto_correct: true   # Backend API
  config.vm.network "forwarded_port", guest: 8080, host: 8080, auto_correct: true   # Jenkins

  # Sync project folder
  config.vm.synced_folder ".", "/vagrant"

  # Same provisioning as main Vagrantfile
  config.vm.provision "shell", inline: <<-SHELL
    apt-get update
    apt-get install -y curl wget git vim

    # Docker
    curl -fsSL https://get.docker.com -o get-docker.sh
    sh get-docker.sh
    usermod -aG docker vagrant

    # kubectl
    ARCH=$(uname -m)
    if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
      KUBECTL_ARCH="arm64"
    else
      KUBECTL_ARCH="amd64"
    fi
    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${KUBECTL_ARCH}/kubectl"
    chmod +x kubectl
    mv kubectl /usr/local/bin/

    # Minikube
    if [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
      MINIKUBE_ARCH="arm64"
    else
      MINIKUBE_ARCH="amd64"
    fi
    curl -LO https://storage.googleapis.com/minikube/releases/latest/minikube-linux-${MINIKUBE_ARCH}
    install minikube-linux-${MINIKUBE_ARCH} /usr/local/bin/minikube

    # Node.js 20
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs

    echo "✅ Vagrant VM setup complete. Run: vagrant ssh, then: cd /vagrant"
  SHELL

  config.vm.post_up_message = <<-MESSAGE
  🎉 Vagrant VM is ready (Parallels)!

  Next:
  1. vagrant ssh
  2. cd /vagrant
  3. minikube start
  4. Follow SETUP_MONITORING.md

  On your Mac: Prometheus http://localhost:9090, Grafana http://localhost:3000
  MESSAGE
end
